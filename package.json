{
  "name": "issue-scout-agent",
  "version": "1.1.0",
  "description": "AI agent for GitHub issue investigation with tool use and Vercel AI SDK",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/presentation/github-actions/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.cjs --log-level=warning",
    "dev": "ts-node src/presentation/github-actions/index.ts",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/openai": "^3.0.68",
    "@octokit/rest": "^22.0.1",
    "ai": "^6.0.197",
    "dotenv": "^17.4.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vercel/ncc": "^0.38.4",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
